<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fm_white"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

  <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/rlVideo"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical">

    <com.otaliastudios.cameraview.CameraView
        android:id="@+id/camera_view_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="80dp"
        android:background="@color/fm_color_normal"
        android:keepScreenOn="true"
        android:visibility="visible"
        app:cameraAudio="off"
        app:cameraEngine="camera2"
        app:cameraMode="picture"
        app:cameraPreview="glSurface" />

    <LinearLayout
        android:id="@+id/llToolbar"
        android:layout_width="match_parent"
        android:layout_height="?android:actionBarSize"
        android:background="@color/fm_white"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent">

      <ImageView
          android:id="@+id/ivBack"
          android:layout_width="50dp"
          android:layout_height="50dp"
          android:layout_marginStart="8dp"
          android:padding="12dp"
          android:src="@drawable/ic_arrow_back" />

      <TextView
          android:id="@+id/tvTitle"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="@color/fm_white"
          android:textColor="@color/fm_black"
          android:textSize="18sp" />
    </LinearLayout>

    <com.liveness.sdk.corev4.facedetector.FaceBoundsOverlay
        android:id="@+id/faceBoundsOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/camera_view_video"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/camera_view_video" />

    <ImageView
        android:id="@+id/imv_frame_face"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="60dp"
        android:layout_marginVertical="40dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@id/vDummy"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/vDummy" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/faceAnim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="30dp"
        android:layout_marginVertical="10dp"
        app:layout_constraintBottom_toBottomOf="@id/vDummy"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/vDummy"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        android:visibility="visible"
        app:lottie_rawRes="@raw/anim_1" />

    <com.liveness.sdk.corev4.facedetector.EllipseView
        android:id="@+id/frMark"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:colorActive="@color/fm_white"
        app:colorNormal="@color/fm_white"
        app:colorWarning="@color/fm_white"
        app:layout_constraintDimensionRatio="1:1.2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llToolbar"
        app:paddingHorizontal="60dp"
        app:paddingVertical="40dp"
        app:strokeWidth="4dp" />
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/loadingAnim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="60dp"
        android:layout_marginStart="58dp"
        android:layout_marginVertical="36dp"
        app:layout_constraintBottom_toBottomOf="@id/vDummy"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/vDummy"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        android:visibility="gone"
        app:lottie_rawRes="@raw/anim_2" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/endAnim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="58dp"
        android:layout_marginStart="60dp"
        android:layout_marginVertical="36dp"
        app:layout_constraintBottom_toBottomOf="@id/vDummy"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/vDummy"
        app:lottie_autoPlay="false"
        app:lottie_loop="false"
        android:visibility="invisible"
        app:lottie_rawRes="@raw/anim_3" />

    <View
        android:id="@+id/vDummy"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1.2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llToolbar" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/fm_white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vDummy" />

    <ImageView
        android:id="@+id/ivLive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_live"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/pbLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progressTint="#005FEB"
        android:visibility="gone"
        android:indeterminate="true"
        android:indeterminateTint="#005FEB"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvStatus"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:gravity="center"
        android:textColor="#000000"
        android:textSize="17sp"
        android:visibility="gone"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vDummy"
        tools:text="@string/fm_face_out_frame"
        tools:visibility="visible" />


  </androidx.constraintlayout.widget.ConstraintLayout>

  <com.liveness.sdk.corev4.slider.SliderView
      android:id="@+id/imageSlider"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>